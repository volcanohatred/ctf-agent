# CTFd connection
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=
# Or session login if the instance doesn't honor tokens:
# CTFD_USER=admin
# CTFD_PASS=admin123

# ── Unified gateway (TWO protocols, SAME models) ─────────────────────────────
# The gateway fronts kimi-k3 / deepseek-v4-flash / qwen3.8-max / glm-5.3 behind
# two API protocols. Configure BOTH for full resilience:
#
#   ANTHROPIC_*  → Anthropic Messages API. PRIMARY path — used by the Claude
#                  Code CLI solvers (claude-sdk/*, the default lineup).
#   GATEWAY_*    → OpenAI-compatible API. FALLBACK — when a claude-cli model
#                  hits quota/rate-limit, the swarm retries the SAME model via
#                  this endpoint (reusing its sandbox). Also used directly by
#                  gateway/* model specs, and by the blackboard summarizer.
#
# NOTE: the agent runs in a container — 127.0.0.1 must be written as
# host.docker.internal to reach a gateway running on the host.
ANTHROPIC_BASE_URL=http://host.docker.internal:8090/anthropic
ANTHROPIC_AUTH_TOKEN=your-gateway-token-here
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=your-gateway-key-here

# Official Anthropic API (only needed if ANTHROPIC_BASE_URL is left empty).
# Read by the Claude Code CLI itself, not by this codebase — but it must be in
# the environment, and compose passes .env through to the container.
ANTHROPIC_API_KEY=

# ── Optional alternative providers ───────────────────────────────────────────
# Only needed for `bedrock/`, `azure/`, `zen/`, `google/` or `gateway/` model
# specs. The default lineup is claude-sdk/* through the gateway above, so all of
# these can stay empty.
# Bedrock (native claude-* models, and the legacy quota fallback target)
AWS_REGION=us-east-1
AWS_BEARER_TOKEN=
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# opencode Zen
OPENCODE_ZEN_API_KEY=
# Direct provider key (only used if you point a model spec at google/*)
GEMINI_API_KEY=
# NOTE: there is no OPENAI_API_KEY. This fork removed the Codex backend and
# resolve_model has no bare `openai/` provider — OpenAI-shaped endpoints are
# reached via GATEWAY_*, AZURE_OPENAI_* or OPENCODE_ZEN_API_KEY. A key here would
# be silently ignored.

# ── Startup health check ─────────────────────────────────────────────────────
# Probe the gateway before launching anything. Without it a misconfigured or
# unreachable ANTHROPIC_BASE_URL shows up as hours of empty "gave up" rounds
# (the CLI reports "API Error: Connection refused" as ordinary assistant text),
# and the benchmark report blames the challenge instead of the network.
STARTUP_HEALTH_CHECK=true
HEALTH_CHECK_TIMEOUT_S=20
# Probe attempts before an endpoint is declared unreachable. A local gateway that
# is merely busy answers a later attempt; a single-shot probe blocked runs that
# went on to solve normally. Auth failures (401/403) are never retried.
HEALTH_CHECK_RETRIES=3

# ── Skill knowledge base ─────────────────────────────────────────────────────
# Local run (agent on host):   SKILLS_DIR=D:/code/ctf/skill/ctf
# Docker run (agent container): SKILLS_DIR=/skills  +  SKILLS_HOST_DIR=<host path>
# BOTH are needed under Docker: SKILLS_DIR is what the AGENT reads (triage,
# index rendering, the approach queue), SKILLS_HOST_DIR is what gets bind-mounted
# into the sandboxes. Setting only the host path silently disables the whole
# skill feature and the anti-loop technique rotation with it.
SKILLS_DIR=
SKILLS_HOST_DIR=

# ── Docker-outside-of-docker ─────────────────────────────────────────────────
# REQUIRED when running via docker-compose: absolute path of THIS project on
# the docker host (forward slashes). Windows: D:/code/ctf/ctf-agent-main/ctf-agent-main
HOST_PROJECT_DIR=

# ── Sandbox resources ────────────────────────────────────────────────────────
# Image the solver sandboxes run in (built from sandbox/Dockerfile.sandbox).
SANDBOX_IMAGE=ctf-sandbox
# Base directory for per-sandbox workspaces. Empty = system temp when the agent
# runs on the host, or <project>/.workspaces under docker-outside-of-docker (it
# must be host-visible there, since the sandbox bind mounts it).
WORKSPACE_ROOT=
CONTAINER_MEMORY_LIMIT=16g
CONTAINER_CPU_LIMIT=2.0
# Per-command wall clock inside the sandbox. Every command is wrapped in
# coreutils `timeout -k 5`, so a round that gets interrupted cannot leave an
# orphaned process burning the container's quota and competing with the next
# round. Raise it for long sage/cado-nfs/volatility runs.
SANDBOX_COMMAND_TIMEOUT_S=900
# Timeout for the Claude Code CLI's own HTTP calls (ms). 0 = CLI default, which
# can stall indefinitely on a half-open connection.
CLI_API_TIMEOUT_MS=600000
# Sweep leftover containers/workspaces from a crashed previous run at startup.
# Set to false on ONE of them if you run two agents concurrently (e.g. a
# coordinator plus a bench) — the sweep matches by label, not by owner, so it
# would otherwise delete the other agent's LIVE sandboxes.
CLEANUP_ORPHANS_ON_START=true

# ── Solver behaviour ─────────────────────────────────────────────────────────
# Per-attempt wall clock. On expiry the turn is INTERRUPTED (not killed), a
# Cairn-style conclude phase harvests what was confirmed from the SAME session,
# and the solver is bumped with a fresh direction. 0 disables.
SOLVER_TIME_BUDGET_S=1500
# Independent budget for that phase-2 conclude harvest.
CONCLUDE_TIMEOUT_S=90
# Hard cap on retry rounds per solver. 0 = unlimited (only sane in coordinator
# mode against a live CTFd — single-challenge mode would never terminate).
# This COUPLES with FRESH_RESTART_ROUNDS: one distil->merge cycle costs
# FRESH_RESTART_ROUNDS bumps, so the cap must be >= 2*FRESH_RESTART_ROUNDS + 1
# for the merged state to drive more than one round. The default 12 with
# FRESH_RESTART_ROUNDS=5 allows two full cycles. A misalignment is warned about
# at startup rather than silently wasting the merge.
MAX_ATTEMPTS_PER_CHALLENGE=12
# Consecutive infrastructure failures across a swarm before it retires itself,
# so a dead gateway costs minutes instead of the whole time limit.
MAX_INFRA_FAILURES=3
# Inject skill-library hint TEXT after N failed attempts (bumps).
#   1 = from the first retry, escalating L1 pointer -> L2 index excerpt + full file
#       list -> L3 similar writeups on each subsequent bump
#   0 = DISABLED, no hint text is ever injected (matches ESCALATE_AFTER_BUMPS)
#   3 = solver works alone for its first two retries
#
# This used to be the one knob where 0 meant the opposite: the gate was
# `bump_count < N`, which can never fire at 0, and the level formula 1+(bump-N)
# then started at L2 — so 0 injected the HEAVIEST tier from the very first retry.
#
# Gates hint text only. Approach rotation has its own switch below, so
# SKILL_AFTER_BUMPS=0 + SKILL_ROTATE_APPROACHES=true is a valid arm: assign a
# direction each retry, inject no handbook excerpt.
SKILL_AFTER_BUMPS=1
# Master switch for the agent-side skill machinery: triage, escalating hint
# injection, and the technique-rotation queue. false leaves the library MOUNTED at
# /skills (that is SKILLS_HOST_DIR's job) so solvers can still read it on their own
# initiative — it only stops the swarm from pushing it at them.
#
# This exists because SKILLS_DIR cannot be the switch: docker-compose.yml pins
# SKILLS_DIR=/skills (the in-container mount point) and compose `environment:`
# overrides `env_file:`, so under Docker there was no way to turn injection off at
# all. That made "does the skill library help THIS model lineup?" unanswerable in the
# mode people actually deploy. This key passes through env_file: normally.
SKILL_HINTS=true
# Rotate the assigned handbook on each retry. Separate switch from the injection
# above, so the two can be A/B'd apart — previously SKILLS_DIR="" turned off both at
# once and rotation had no switch of its own, which is why a solve-rate regression
# could not be attributed to either half.
#
# Rotation is the more suspicious half, and specifically for weaker or quantized
# models: handbooks are assigned in ALPHABETICAL order within a pack, unrelated to
# what the solver is actually stuck on, and the bump text is imperative
# ("本轮专攻新方向…先读再做"). A strong model judges that irrelevant and ignores it; a
# weaker one tends to obey literally and spends the round reading a file that does
# not apply.
#
# A/B recipe — one variable per arm, everything else identical. Compare with
# ctf-bench and CHECK `usable_run` in the report before reading any solve rate:
#   arm 1  SKILL_HINTS=true   SKILL_ROTATE_APPROACHES=true   SKILL_AFTER_BUMPS=1  (all active)
#   arm 2  SKILL_HINTS=true   SKILL_ROTATE_APPROACHES=false  SKILL_AFTER_BUMPS=1  (injection only)
#   arm 3  SKILL_HINTS=true   SKILL_ROTATE_APPROACHES=true   SKILL_AFTER_BUMPS=0  (rotation only)
#   arm 4  SKILL_HINTS=false  (SKILLS_HOST_DIR still set)                         (passive library)
#   arm 5  SKILL_HINTS=false  SKILLS_HOST_DIR=                                    (no library)
# arm1-vs-2 isolates rotation, 1-vs-3 isolates the handbook text, 3-vs-4 asks
# whether being assigned a direction at all is worth anything, 4-vs-5 asks whether a
# library the model may read unprompted is worth anything. Per-challenge variance on
# a 10-challenge set is large enough that one run's difference is often noise — run
# each arm more than once if you can afford it.
SKILL_ROTATE_APPROACHES=true
# After this many total failed bumps with no winner, add a stronger solver.
# 0 DISABLES the ladder. The candidate is picked from COORDINATOR_MODEL then a
# built-in preference order, skipping anything already in the lineup.
ESCALATE_AFTER_BUMPS=8
# Fresh-restart retry: distil each round into a journal, reset the session, and
# restart clean carrying only the distilled state.
#
# N is the MERGE INTERVAL, not a restart interval. ANY value > 0 restarts the
# session on every bump; 0 is the only setting that gives you the continue-session
# bump. This comment used to claim "0/1 disables", which was wrong for 1 — and 1 is
# the most expensive value available, because the journal is meta-summarized after
# every single round and never accumulates more than one entry. validate_tuning
# warns at startup if you set it.
FRESH_RESTART_ROUNDS=5
# Grace period for siblings to wind down after one solver wins. They watch
# cancel_event and exit within a couple of seconds, which lets each finish its own
# container/workspace teardown; only stragglers are hard-cancelled. Too short and
# teardown gets interrupted, leaking a container and a workspace per sibling.
SOLVER_TEARDOWN_GRACE_S=60
# Backoff between rounds: base + step*round, capped at max.
BUMP_COOLDOWN_BASE_S=5
BUMP_COOLDOWN_STEP_S=10
BUMP_COOLDOWN_MAX_S=120
QUOTA_BACKOFF_BASE_S=60
QUOTA_BACKOFF_MAX_S=300

MAX_CONCURRENT_CHALLENGES=10
# How many times a challenge may be auto-spawned. The coordinator re-checks for
# unsolved challenges with no active swarm every status interval — that is what
# makes it self-heal after a swarm retires (round cap / quota / infrastructure),
# and what lets it notice a CTFd solve-history reset, since CTFd emits no event
# for a challenge becoming unsolved. The cap stops a hopeless challenge from
# being re-queued forever.
MAX_SPAWNS_PER_CHALLENGE=3

# ── Coordinator ──────────────────────────────────────────────────────────────
# The "coach" that reads solver traces and sends guidance. Use your STRONGEST
# model here (solvers can be weaker). Empty = CLI flag / built-in default
# (qwen3.8-max). This value also seeds the escalation ladder.
COORDINATOR_MODEL=
# Wall-clock cap for a single coordinator LLM turn. Without it a stalling
# gateway freezes the whole event loop — poller, patrol, operator messages and
# dashboard all stop, with nothing in the log to say why.
COORDINATOR_TURN_TIMEOUT_S=300
# Proactive patrol: detect stuck solvers and nudge them via the mailbox.
# Scan every N seconds (0 disables).
PATROL_INTERVAL_S=120
# No trace activity for this long counts as stuck.
PATROL_STUCK_QUIET_S=240

# ── Blackboard summarization ─────────────────────────────────────────────────
# Long findings get an LLM key-info summary for sibling injection (the full text
# is always kept; nothing is truncated). Uses the GATEWAY_* endpoint and IS
# accounted for in the cost totals.
SUMMARIZE_THRESHOLD_CHARS=900
SUMMARIZER_MODEL=deepseek-v4-flash
# Budget for every summarizer-class call: the per-round distillation, the
# FRESH_RESTART_ROUNDS journal merge, and long-finding summaries. A reply cut off
# by the token cap is DISCARDED, not partially used — so a cap that is too tight
# silently drops rounds out of the carried state, which is the exact thing the
# journal merge exists to keep bounded. Measured on a live run: 900 was hit five
# times in thirteen minutes.
SUMMARIZER_MAX_TOKENS=2500
SUMMARIZER_TIMEOUT_S=60
# Retries when a reply comes back truncated, each with the budget multiplied by 4
# (capped at 32000). Needed because two of the summarizer prompts — the per-round
# distillation that feeds the journal, and the long-finding summary — demand that
# EVERY path, offset, key and credential survive, with no length bound, so their
# natural output grows with the round. No fixed cap is provably sufficient for
# those; the other two prompts are line-bounded (12 and 16 lines) and never come
# close. 0 restores the old discard-on-truncation behaviour.
SUMMARIZER_TRUNCATION_RETRIES=1
# Sent as a top-level `reasoning_effort` field on summarizer-class calls ONLY.
# SUMMARIZER_MODEL is a reasoning model and max_tokens caps reasoning + visible
# content TOGETHER. Measured against a live gateway at max_tokens=2500:
#   baseline               finish=length  reasoning_tokens=2500  content=0 chars
#   reasoning_effort=none  finish=length  reasoning_tokens=0     content=5838 chars
# The model spent the whole budget thinking and emitted no answer at all. Growing
# the cap buys more thinking, not more answer — 2500 -> 10000 still truncated —
# and a length instruction in the prompt cannot help, because the truncation
# happens upstream of the text it would constrain. Empty = do not send the field.
# AUDIT / STRATEGIST / BRIEFING / triage deliberately never set this: for those the
# reasoning IS the product. If a gateway 400s on the field it is detected once,
# logged, and dropped for the rest of the process rather than killing every call.
SUMMARIZER_REASONING_EFFORT=none
# The team digest merges what ALL solvers on a challenge have established into
# one de-duplicated state, so a restarting solver (whose session was just wiped)
# recovers the whole team's picture instead of "each model's latest finding,
# clipped to 400 chars". Recomputed at most once per bump generation and shared
# by every solver restarting in it — N solvers cost one call, not N.
# Minimum distinct reports before spending a call on it:
SIBLING_DIGEST_MIN_REPORTS=2
# Recompute at most once every N bumps:
SIBLING_DIGEST_REFRESH_BUMPS=1

# ── Fact trust gate (anti-hallucination) ─────────────────────────────────────
# The blackboard is the swarm's only shared memory and every restart payload is
# built from it, so a false entry is not one model's problem — it is inherited as
# ground truth by every sibling and every fresh restart after it.
# With this ON, a finding one solver asserts is published as an UNVERIFIED CLAIM
# (⚠) and is promoted to a corroborated FACT (✓) only when a DIFFERENT solver
# independently reports the same thing. A solver repeating its own claim after a
# session wipe does NOT count — that is exactly how a hallucination survives a
# restart. Matching is structural (backend/dedup.py), so it costs no LLM calls.
# Set false to restore "everything a solver reports is a fact".
CORROBORATE_FACTS=true

# ── Active verification (the Verifier) ───────────────────────────────────────
# Corroboration can only WITHHOLD trust. It has two holes that cost solve rate:
#   * it can never REFUTE — a false premise is not labelled trusted, but it stays
#     on the board, still readable, still tempting, and solvers keep deriving from
#     it; on the run this was built after, "the uploaded JAR does get loaded" was
#     never corroborated and never contradicted, and four solvers spent hours on
#     payloads built on top of it.
#   * it can never CONFIRM — a true finding that is hard to rediscover stays ⚠
#     forever and gets under-weighted, a false negative on the one thing the swarm
#     most needs.
# Both close the same way: somebody actually runs a test. The Verifier owns ONE
# sandbox per swarm, reused across claims, created lazily on the first testable
# claim, and runs concurrently with the solvers so it costs no wall-clock.
# A REFUTED claim moves into the dead-end ledger AND broadcasts a prune notice
# that reaches running solvers within a few tool calls, not at their next restart.
# Any ambiguous, crashed, timed-out or evidence-free probe resolves to
# INCONCLUSIVE — a wrong REFUTED kills the one attack that might have worked.
VERIFY_CLAIMS=true
# Model spec for the Verifier. Empty = the first solver in the lineup.
# Verification is judgement-heavy: a weak model returns INCONCLUSIVE for
# everything, which is safe but useless.
VERIFIER_MODEL=
# Wall-clock budget for ONE probe. Deliberately far below SOLVER_TIME_BUDGET_S —
# a "minimal falsifying test" that needs 25 minutes is not minimal.
VERIFIER_BUDGET_S=300
# Pre-filter each claim with one cheap call: is it testable by a probe at all, and
# would its falsity invalidate other agents' work? This is NOT a cost control, it
# is a wall-clock control — a probe that cannot falsify anything still occupies the
# verifier for a whole round. If the triage call itself fails, the claim is
# verified anyway: an optimisation must not be able to silently disable the one
# mechanism that can catch a false premise.
VERIFIER_TRIAGE=true
# Triage decides whether a claim is worth spending a decisive probe on. Its reply
# is discarded if truncated, and "no answer" means the verifier probes blind —
# safe, but it burns the one resource VERIFIER_MAX_PROBES rations. The 1500/25s
# this replaces was observed truncating live.
VERIFIER_TRIAGE_MAX_TOKENS=4000
VERIFIER_TRIAGE_TIMEOUT_S=60
# Hard cap on decisive probes per challenge. 0 = unlimited (the claim queue is
# bounded either way). Raise it for an exhaustive audit.
VERIFIER_MAX_PROBES=0

# ── Strategist + stale-round circuit breaker ─────────────────────────────────
# Both exist for the same failure: every solver grinding tactically (fuzzing
# payload variants, enumerating class names) while nobody re-reads the challenge
# text. They are cheap and they are the only mechanism that can end a dead
# paradigm rather than rotate within it.
#
# Consult the Strategist every N swarm-wide bumps. It is shown ONLY the challenge
# metadata and the dead-end ledger — never the tactical findings that drown the
# signal — and must answer CONTINUE or PIVOT with a concrete new attack surface.
# The verdict is broadcast as a 📢 strategist message, kept distinct from a ✓
# fact. Requires the GATEWAY_* endpoint; cost is tracked under <chall>/strategist.
# 0 disables. At most one consult per interval no matter how many solvers bump.
STRATEGIST_EVERY_BUMPS=4
# Model for the Strategist. Empty = COORDINATOR_MODEL, else qwen3.8-max.
# Deliberately NOT SUMMARIZER_MODEL — this is deep semantic reasoning over the
# challenge text, and a flash model just rubber-stamps CONTINUE.
STRATEGIST_MODEL=
# Model for JUDGEMENT calls generally — the Strategist and the contradiction audit.
# Empty = COORDINATOR_MODEL, else a built-in reasoning default.
# This exists because SUMMARIZER_MODEL is the wrong tool for these two, and the
# failure is invisible: measured against a live gateway, the flash summarizer
# answered "NONE" to an unambiguous conflicting pair (finish_reason=stop, so not
# truncation — it genuinely could not see the conflict) while a reasoning model
# found it in 8.7s with a correct explanation. Both mechanisms fail silently, so a
# weak model here does not degrade them, it deletes them.
REASONING_MODEL=
# Wall clock for ONE strategist consultation. Measured 100-150s on a reasoning
# model, which spends ~3000 tokens thinking before answering. Do not lower this
# without measuring: at 60s every call timed out and the strategist was silently
# dead in production while looking configured and healthy.
STRATEGIST_TIMEOUT_S=300
# Completion budget for the strategist. Reasoning models burn most of it thinking.
# At 1200 the reply came back finish_reason="length" after 6743 tokens, so the
# verdict line was never emitted and the truncated tail was read as CONTINUE —
# reporting the opposite of what the model had concluded. Truncation is now
# detected and refused, but it should not happen in the first place.
STRATEGIST_MAX_TOKENS=8000
# Minimum seconds between ANY two consultations, including the ones the stale-round
# breaker forces. The periodic path is rate-limited by bump generation, but a forced
# call bypasses that, so four stuck solvers each tripping the breaker produced four
# strong-model calls per cycle with no ceiling. 0 disables the interval.
STRATEGIST_MIN_INTERVAL_S=120
# Contradiction audit overrides. Empty / 0 = REASONING_MODEL and module defaults.
# The audit runs on a reasoning model over a board that grows all run, so its
# latency grows with it. Measured live: the one round that finished took 115.5s
# against the old 120s ceiling and the other six timed out — a ceiling that only
# just fits an early round silently switches the audit off for the rest of the
# run, and the swarm keeps building on premises nobody is checking.
AUDIT_MODEL=
AUDIT_TIMEOUT_S=300
AUDIT_MAX_TOKENS=8000
# ── Command-centre chat ──────────────────────────────────────────────────────
# "What is the progress on <challenge>?" Summarises one challenge's entire live
# state — the whole blackboard with its trust tiers, per-solver traces, dead ends,
# audit counters — for an operator who cannot read four hours of logs. Also a
# reasoning task: it must not upgrade a ⚠ claim into a fact while summarising, or
# the operator steers the swarm on a hallucination.
BRIEFING_MODEL=
BRIEFING_TIMEOUT_S=300
BRIEFING_MAX_TOKENS=8000
# After N consecutive rounds in which a solver added NOTHING new to the team
# (every dead end it reported was already recorded, every fact already asserted
# by someone), force a Strategist consult and hand that solver a hard redirect
# forbidding further micro-tweaks of the same payload. This catches what the
# per-command loop detector cannot: each tweak is a genuinely different command,
# so no signature ever repeats. Infrastructure failures and empty spins are
# excluded — those belong to MAX_INFRA_FAILURES. 0 disables.
STALE_ROUND_LIMIT=3

# ── Contradiction audit ──────────────────────────────────────────────────────
# The Verifier tests a claim against the TARGET. This tests claims against EACH
# OTHER: every round's new statements are compared against the whole board, and a
# pair that cannot both be true is broadcast and pushed to the front of the
# verification queue.
#
# This catches the case the board itself hides — two agents holding mutually
# exclusive beliefs while both look productive. Observed live as the thing that
# should have ended a four-hour run in four minutes: one agent had recorded that
# the allowlist rejects a gadget class, another was building a payload out of that
# same class, and both statements sat side by side on the board the whole time.
#
# The broadcast deliberately does NOT say which side is wrong. The audit has no
# evidence for that, and picking one would be a new unverified claim wearing an
# authoritative label. A probe settles it.
AUDIT_CONTRADICTIONS=true

# ── Operator dashboard ───────────────────────────────────────────────────────
# Loopback by default on purpose: the dashboard can inject instructions into
# solvers (which run arbitrary code in privileged sandboxes), spawn containers,
# and export confirmed flags. Solver sandboxes can also reach the host via
# host.docker.internal, so a 0.0.0.0 bind without auth was effectively a
# remote-control and flag-disclosure endpoint. Bind to 0.0.0.0 only behind a
# reverse proxy that adds its own auth.
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1
# Bearer token required on every request. Empty = a random token is generated at
# startup and printed once, with the ready-to-open URL.
DASHBOARD_TOKEN=
# Max characters of blackboard content per finding in the live /api/state feed
# (the export endpoint always returns the full text).
DASHBOARD_FEED_CHARS=4000

# ── Operator message endpoint (ctf-msg) ──────────────────────────────────────
# Must match what `ctf-msg` dials (default 9400) and the published compose port.
# 0 = auto-pick a free port, which breaks `ctf-msg` unless you pass --port.
MSG_PORT=9400
MSG_HOST=127.0.0.1

# ── web_fetch egress guard ───────────────────────────────────────────────────
# Comma-separated hostnames the AGENT may fetch even though they resolve to a
# non-public address. Everything else private is blocked by RESOLVED IP, not by
# hostname prefix. Keep this as short as possible.
WEB_FETCH_ALLOW_HOSTS=host.docker.internal

# HTTP(S) proxy injected into solver sandboxes (lets git/curl reach github etc.)
SANDBOX_PROXY_URL=
